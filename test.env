# Chave privada da sua conta Aleo
PRIVATE_KEY=APrivate

# URL do RPC (use a que você quiser)
RPC_URL=https://api.explorer.provable.com/v2

# Endpoint para broadcast (CLI)
ENDPOINT=https://api.explorer.provable.com/v2

# Rede (testnet, mainnet, etc.)
NETWORK=testnet

# Versão de consenso
CONSENSUS_VERSION=9

# Diretório onde os templates serão salvos
TEMPLATES_DIR=./templates

# Gas padrão para deploy (em créditos)
DEPLOY_FEE=10

# Chain ID padrão (se não for passado por CLI)
DEFAULT_CHAIN_ID=2011

# Gas token ID padrão
DEFAULT_GAS_TOKEN_ID=1

# Endereço do sequenciador (pode ser o mesmo da sua conta)
DEFAULT_SEQUENCER_ADDRESS=aleo1s69


# Nome da pasta do template da L3 (sem o caminho completo)
L3_FOLDER_NAME=woo_genesis_2011

# ID do nó (identificação no cluster P2P)
NODE_ID=node1

# Lista de sequenciadores (separados por vírgula)
SEQUENCERS_LIST=node1

# URL do servidor Rust que gera/verifica provas ZK
ZK_PROVER_URL=http://localhost:3030

# Rede (testnet/mainnet)
NETWORK=testnet

# ===== PORTAS =====
HTTP_PORT=8545
P2P_PORT=6000

# ===== CONFIGURAÇÕES DE BATCH =====
# Intervalo entre tentativas do sequencer (ms)
SEQUENCER_INTERVAL_MS=15000

# Taxa de execução de contrato (em tokens de gás)
EXECUTION_FEE=5
INITIAL_GAS_SUPPLY=1000000